# Portugal Active — Environment Variables
# Copia este ficheiro para .env.local e preenche os valores reais
# NUNCA commites o .env.local para o git

# ── Guesty API ──────────────────────────────────────────────
# Vai a: Guesty App → Settings → API → API Keys
# Cola aqui o teu API Key (token de acesso direto)
GUESTY_API_KEY=cole_aqui_o_teu_token

# ── Database (TiDB Cloud) ───────────────────────────────────
DATABASE_URL=mysql://user:password@host:port/database

# ── App ─────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ── Cloudflare (purga de cache e regra de cache) ─────────────
# Token em https://dash.cloudflare.com/profile/api-tokens
# Permissões: Zone → Cache Purge → Purge  (e Zone → Cache Rules → Edit
# se quiseres correr o cf-cache-rule.mjs)
CLOUDFLARE_API_TOKEN=
# Opcional — se ausente, é resolvido a partir de portugalactive.com
CLOUDFLARE_ZONE_ID=
