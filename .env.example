# =============================================================================
# Portugal Active — todas as variáveis que NÃO vão para o Git
# Copiar para .env (local) e preencher. No Render: Environment → mesmos nomes.
# Valores reais nunca em commits.
# =============================================================================

# ─── Infra (Render define PORT automaticamente) ─────────────────────────────
# NODE_ENV=production
# PORT=3000

# ─── Site ───────────────────────────────────────────────────────────────────
# URLs canónicas, sitemap, emails
SITE_URL=https://www.portugalactive.com

# ─── Guesty Open API — listings, availability, quotes ─────────────────────────
GUESTY_CLIENT_ID=
GUESTY_CLIENT_SECRET=
# Opcional: só se Guesty indicar outro host (default https://open-api.guesty.com)
# GUESTY_BASE_URL=https://open-api.guesty.com
# Após 429 no OAuth: máx. cooldown em ms (defaults 120000 / 180000 BE)
# GUESTY_MAX_OAUTH_COOLDOWN_MS=120000
# GUESTY_MAX_BE_OAUTH_COOLDOWN_MS=180000

# ─── Guesty Booking Engine — checkout / pagamento no site ───────────────────
GUESTY_BE_CLIENT_ID=
GUESTY_BE_CLIENT_SECRET=

# ─── Guesty webhooks (validação de assinatura no servidor) ──────────────────
GUESTY_WEBHOOK_SECRET=

# ─── Debug ops: POST /api/debug/guesty/reset-cooldown + header x-guesty-debug-secret
GUESTY_DEBUG_SECRET=

# ─── Stripe — mesma conta ligada ao Guesty; publishable vai no bundle ────────
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=sk_live_...           # Platform Stripe secret key (NOT connected account)
STRIPE_PAYPAL_WEBHOOK_SECRET=whsec_... # Stripe webhook secret for PayPal events
STRIPE_ACCOUNT_ID=

# ─── Base de dados (MySQL / TiDB); opcional em dev se não usares features DB ─
DATABASE_URL=

# ─── JWT — obrigatório em produção (env.ts falha o arranque sem isto) ────────
# Gerar: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# ─── Google OAuth — login de clientes ───────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── OAuth / app (core env.ts + cliente) ───────────────────────────────────
# Servidor OAuth externo (se usado); VITE_* expostos ao browser no build
OAUTH_SERVER_URL=
OWNER_OPEN_ID=
VITE_APP_ID=
VITE_OAUTH_PORTAL_URL=

# ─── Forge API (servidor + mapa no cliente) ─────────────────────────────────
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
VITE_FRONTEND_FORGE_API_URL=
VITE_FRONTEND_FORGE_API_KEY=

# ─── ActiveCampaign — CRM / newsletter ──────────────────────────────────────
ACTIVECAMPAIGN_API_URL=
ACTIVECAMPAIGN_API_KEY=
# ACTIVECAMPAIGN_CONTACTS_LIST_ID=
# ACTIVECAMPAIGN_NEWSLETTER_LIST_ID=

# ─── Guesty sync → GitHub (scripts / automação) ────────────────────────────
# GITHUB_PAT=
# GITHUB_REPO=owner/repo
# GITHUB_BRANCH=main

# ─── Admin (password) quando OAuth não está configurado; requer DATABASE_URL ─
ADMIN_PASSWORD=

# ─── Bókun — widget de booking para experiences ────────────────────────────
VITE_BOKUN_CHANNEL_UUID=

# ─── Prerender.io — serve HTML pré-renderizado a bots (Googlebot, etc.) ─────
# Criar conta em prerender.io, copiar o token. Só ativar em produção.
PRERENDER_TOKEN=

# ─── Analytics — injetado no build (Vite define __VITE_GA4_ID__) ────────────
VITE_GA4_ID=

# =============================================================================
# Notas Render / Vite
# - Variáveis VITE_* têm de existir no momento do BUILD estático (não só runtime).
# - Após alterar env no Render: redeploy ou “Clear build cache” se o front não atualizar.
# =============================================================================

# Checkout 2.0 (Fase 1) — ativa o checkout fullscreen /checkout/:intentId.
# No Render (dev): CHECKOUT_V2=true. Override local de teste: ?checkoutv2=1 no URL.
CHECKOUT_V2=false

# ─── Flags de runtime (auditoria set/2026, G4) ──────────────────────────────
# SSR_ENABLED=false desliga o render no servidor (cai para o shell CSR + #seo-content). Default: ligado.
SSR_ENABLED=true
# CHECKOUT_RECOVERY=false desliga os emails de recuperação de checkout (1h + 20h). Default: ligado.
CHECKOUT_RECOVERY=true
# TRIPWIX_INVENTORY=0 tira as 35 casas do parceiro do site sem deploy (kill switch). Default: ligado.
TRIPWIX_INVENTORY=1
# VISIT_ORIGIN_NOTE=1 escreve a linha "Origem:" (origem da visita) na nota da reserva do Guesty.
# Default: desligado. Ligar só depois de o pa-marketing (campaign_bookings.py) retirar essas linhas
# antes de procurar os códigos das campanhas. A captura, a tabela e o email [Venda direta] não dependem disto.
VISIT_ORIGIN_NOTE=0

# ─── Cloudflare — purga automática da CDN no arranque em produção ───────────
# Token com Zone → Cache Purge → Purge (e Zone → Zone → Read se não definires o ZONE_ID).
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
# CLOUDFLARE_ZONE_NAME=portugalactive.com

# Recovery emails: enable only on production, with SITE_URL=https://www.portugalactive.com.
# DEV/previews may share the database and MUST NOT run this scheduler.
CHECKOUT_RECOVERY=false

# ─── Newsletter do site (pop-up, bloco da casa, bloco do artigo, rodapé) ────
# Funciona sem chave nova: guarda a inscrição na tabela leads (o coletor da PA
# Mailing List lê-a de 6 em 6 horas) e envia a dupla confirmação pelo email
# transacional que o site já usa (RESEND_API_KEY). Sem DATABASE_URL ou
# RESEND_API_KEY, e em qualquer preview, os formulários ficam escondidos.
# Documentação: docs/newsletter.md.
# Línguas do pop-up e dos blocos. Default: pt. Com o default, ES e EN ficam sem inscrição
# nenhuma (o rodapé antigo existia nas 9 línguas): regressão registada em docs/newsletter.md.
# TODO(humano): NEWSLETTER_LOCALES=pt,es,en depois da revisão nativa de ES e EN (reabertura
# prevista segunda 12 de outubro; o anúncio (b) na Galiza fica preso a essa data).
NEWSLETTER_LOCALES=pt
# Línguas do formulário do rodapé. Vazio: as mesmas do NEWSLETTER_LOCALES (pt até à
# revisão nativa das outras: os textos do formulário, a frase de consentimento, o email e
# as páginas são novos). Abrir mais línguas antes dessa revisão é decisão do Ricardo.
# Nas línguas sem a linha da origem da visita na política de privacidade
# (privacy.s2OriginBody, hoje só PT) a inscrição não guarda a origem da visita.
# Exemplo: NEWSLETTER_FOOTER_LOCALES=pt,es,en
NEWSLETTER_FOOTER_LOCALES=
# NEWSLETTER_POPUP=false desliga só o pop-up, sem deploy. Default: ligado.
NEWSLETTER_POPUP=true
# Página de cada casa: NEWSLETTER_HOUSE_ALERTS=true mostra a versão que promete o aviso
# ("Quer saber quando esta casa tiver datas livres ou preço de época baixa? ... avisamos").
# Default: desligado ("Gostou desta casa?", a casa fica registada como interesse).
# TODO(humano): ligar só depois de o Ricardo aprovar a regra de avisos por casa no CRM.
NEWSLETTER_HOUSE_ALERTS=false
# Segredo dos links de confirmação e de saída. Opcional: sem ele usa o JWT_SECRET.
# Só em Production; recusado em previews (FORBIDDEN_PREVIEW_KEYS).
NEWSLETTER_TOKEN_SECRET=
# Tempos do pop-up (opcional): 8 s no computador, 15 s ou 40% da página no telemóvel.
# NEWSLETTER_POPUP_DESKTOP_MS=8000
# NEWSLETTER_POPUP_MOBILE_MS=15000
# NEWSLETTER_POPUP_SCROLL_PCT=40
# Só para ver o visual num preview ou em npm run dev (as inscrições falham aí). Nunca em Production.
# NEWSLETTER_UI_PREVIEW=true
# Brevo, opcional: com as duas, quem confirma com um clique que parece humano entra na
# lista própria do site no Brevo e quem sai é retirado. Sem elas nada é chamado.
# BREVO_NEWSLETTER_LIST_ID é o id da lista "Newsletter do site" (pasta PA Marketing no Brevo),
# a lista própria do site. NUNCA o id da lista "Newsletter" nem o da "Base de hóspedes": essas
# são do robô Base do pa-marketing, que tira delas quem ainda não está no catálogo da Mailing
# List (os subscritores acabados de chegar), e o robô das boas-vindas recusa-as.
# É o mesmo número que a sessão de CRM põe em growth.settings.site_newsletter_list_id.
# TODO(humano): chave própria do site, criada no Brevo, só em Production; e o id da lista
# "Newsletter do site" (criada pela sessão de CRM), o mesmo de growth.settings.site_newsletter_list_id.
BREVO_API_KEY=
BREVO_NEWSLETTER_LIST_ID=
