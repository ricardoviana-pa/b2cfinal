# =============================================================================
# Portugal Active — todas as variáveis que NÃO vão para o Git
# Copiar para .env (local) e preencher. No Render: Environment → mesmos nomes.
# Valores reais nunca em commits.
# =============================================================================

# ─── Infra (Render define PORT automaticamente) ─────────────────────────────
# NODE_ENV=production
# PORT=3000

# ─── Site ───────────────────────────────────────────────────────────────────
# URLs canónicas, sitemap, emails
SITE_URL=https://www.portugalactive.com

# ─── Guesty Open API — listings, availability, quotes ─────────────────────────
GUESTY_CLIENT_ID=
GUESTY_CLIENT_SECRET=
# Opcional: só se Guesty indicar outro host (default https://open-api.guesty.com)
# GUESTY_BASE_URL=https://open-api.guesty.com
# Após 429 no OAuth: máx. cooldown em ms (defaults 120000 / 180000 BE)
# GUESTY_MAX_OAUTH_COOLDOWN_MS=120000
# GUESTY_MAX_BE_OAUTH_COOLDOWN_MS=180000

# ─── Guesty Booking Engine — checkout / pagamento no site ───────────────────
GUESTY_BE_CLIENT_ID=
GUESTY_BE_CLIENT_SECRET=

# ─── Guesty webhooks (validação de assinatura no servidor) ──────────────────
GUESTY_WEBHOOK_SECRET=

# ─── Debug ops: POST /api/debug/guesty/reset-cooldown + header x-guesty-debug-secret
GUESTY_DEBUG_SECRET=

# ─── Stripe — mesma conta ligada ao Guesty; publishable vai no bundle ────────
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=sk_live_...           # Platform Stripe secret key (NOT connected account)
STRIPE_PAYPAL_WEBHOOK_SECRET=whsec_... # Stripe webhook secret for PayPal events
STRIPE_ACCOUNT_ID=

# ─── Base de dados (MySQL / TiDB); opcional em dev se não usares features DB ─
DATABASE_URL=

# ─── JWT — obrigatório em produção (env.ts falha o arranque sem isto) ────────
# Gerar: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# ─── Google OAuth — login de clientes ───────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── OAuth / app (core env.ts + cliente) ───────────────────────────────────
# Servidor OAuth externo (se usado); VITE_* expostos ao browser no build
OAUTH_SERVER_URL=
OWNER_OPEN_ID=
VITE_APP_ID=
VITE_OAUTH_PORTAL_URL=

# ─── Forge API (servidor + mapa no cliente) ─────────────────────────────────
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
VITE_FRONTEND_FORGE_API_URL=
VITE_FRONTEND_FORGE_API_KEY=

# ─── ActiveCampaign — só o aviso de contacto (sendContactNotification) ──────
# A newsletter deixou de passar por aqui (26 set 2026): ver o bloco Brevo abaixo.
ACTIVECAMPAIGN_API_URL=
ACTIVECAMPAIGN_API_KEY=
# ACTIVECAMPAIGN_CONTACTS_LIST_ID=

# ─── Newsletter — captação no site com dupla confirmação no Brevo ───────────
# Só em produção (www). Em dev e previews estas chaves são recusadas no
# arranque (FORBIDDEN_PREVIEW_KEYS) e o POST devolve 503 de qualquer forma.
# NEWSLETTER_POPUP=false desliga o pop-up sem deploy (o bloco e o rodapé ficam).
NEWSLETTER_POPUP=true
# Línguas em que o pop-up e o bloco aparecem. Só PT até haver revisão nativa
# de ES e EN (regra global das duas primeiras peças): depois NEWSLETTER_LOCALES=pt,es,en
NEWSLETTER_LOCALES=pt
# Atraso do pop-up em milissegundos (ou 50% de scroll, o primeiro que chegar)
NEWSLETTER_POPUP_DELAY_MS=20000
# Como sai o email de boas-vindas depois do clique de confirmação:
#   event         → POST /v3/events "newsletter_confirmada"; a automação do Brevo envia (por LINGUA)
#   transactional → POST /v3/smtp/email com BREVO_WELCOME_TEMPLATE_ID_<LANG> (plano B, sem automações)
#   off           → não envia
NEWSLETTER_WELCOME_MODE=event
# Chave de API do Brevo SÓ para o site (criar uma segunda chave no Brevo para
# rodar uma sem partir a outra). Nunca no repositório, nunca no dev.
BREVO_API_KEY=
# Ids impressos por b-crm/jobs/newsletter_setup.py (pa-marketing) depois de correr a sério
BREVO_NEWSLETTER_LIST_ID=
BREVO_DOI_TEMPLATE_ID_PT=
BREVO_DOI_TEMPLATE_ID_ES=
BREVO_DOI_TEMPLATE_ID_EN=
BREVO_WELCOME_TEMPLATE_ID_PT=
BREVO_WELCOME_TEMPLATE_ID_ES=
BREVO_WELCOME_TEMPLATE_ID_EN=
# HMAC do link de confirmação (cai para RECOVERY_OPTOUT_SECRET e depois JWT_SECRET)
NEWSLETTER_TOKEN_SECRET=
# Oferta de boas-vindas: vazio até o Ricardo decidir. Com os três preenchidos, o
# email de boas-vindas leva a frase do código; a data escreve-se a partir do cupão
# do Guesty (aaaa-mm-dd), nunca à mão. Nunca julho e agosto.
NEWSLETTER_WELCOME_CODE=
NEWSLETTER_WELCOME_CODE_UNTIL=
NEWSLETTER_WELCOME_PCT=

# ─── Guesty sync → GitHub (scripts / automação) ────────────────────────────
# GITHUB_PAT=
# GITHUB_REPO=owner/repo
# GITHUB_BRANCH=main

# ─── Admin (password) quando OAuth não está configurado; requer DATABASE_URL ─
ADMIN_PASSWORD=

# ─── Bókun — widget de booking para experiences ────────────────────────────
VITE_BOKUN_CHANNEL_UUID=

# ─── Prerender.io — serve HTML pré-renderizado a bots (Googlebot, etc.) ─────
# Criar conta em prerender.io, copiar o token. Só ativar em produção.
PRERENDER_TOKEN=

# ─── Analytics — injetado no build (Vite define __VITE_GA4_ID__) ────────────
VITE_GA4_ID=

# =============================================================================
# Notas Render / Vite
# - Variáveis VITE_* têm de existir no momento do BUILD estático (não só runtime).
# - Após alterar env no Render: redeploy ou “Clear build cache” se o front não atualizar.
# =============================================================================

# Checkout 2.0 (Fase 1) — ativa o checkout fullscreen /checkout/:intentId.
# No Render (dev): CHECKOUT_V2=true. Override local de teste: ?checkoutv2=1 no URL.
CHECKOUT_V2=false

# ─── Flags de runtime (auditoria set/2026, G4) ──────────────────────────────
# SSR_ENABLED=false desliga o render no servidor (cai para o shell CSR + #seo-content). Default: ligado.
SSR_ENABLED=true
# CHECKOUT_RECOVERY=false desliga os emails de recuperação de checkout (1h + 20h). Default: ligado.
CHECKOUT_RECOVERY=true
# TRIPWIX_INVENTORY=0 tira as 35 casas do parceiro do site sem deploy (kill switch). Default: ligado.
TRIPWIX_INVENTORY=1

# ─── Cloudflare — purga automática da CDN no arranque em produção ───────────
# Token com Zone → Cache Purge → Purge (e Zone → Zone → Read se não definires o ZONE_ID).
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
# CLOUDFLARE_ZONE_NAME=portugalactive.com

# Recovery emails: enable only on production, with SITE_URL=https://www.portugalactive.com.
# DEV/previews may share the database and MUST NOT run this scheduler.
CHECKOUT_RECOVERY=false
